# production / development / test（development では HTTP でも管理画面の Cookie を使える）
APP_ENV=development

# 公開 URL。OGP・シェア URL・Turnstile の hostname 検証に使う
BASE_URL=http://localhost:8000

POSTGRES_DB=kikoeru
POSTGRES_USER=kikoeru
# 長いランダム文字列に変更する（openssl rand -hex 24）
POSTGRES_PASSWORD=change-me-db-password
# 上の値と合わせる
DATABASE_URL=postgresql+asyncpg://kikoeru:change-me-db-password@db:5432/kikoeru

REDIS_URL=redis://redis:6379/0

# 既定値は Cloudflare 公式のテスト用キー（常に成功）。本番では自分のキーに変更する
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# リモート管理型トンネルのトークン。空なら cloudflared は待機状態で起動する
TUNNEL_TOKEN=

# IP アドレスをハッシュ化するソルト（openssl rand -hex 32）。運用開始後は変更しない
IP_HASH_SALT=change-me-ip-hash-salt
# 管理画面セッションの HMAC 鍵（openssl rand -hex 32）
SESSION_SECRET=change-me-session-secret
# /metrics を Bearer トークンで取得する場合に設定（空なら管理者ログイン時のみ）
METRICS_TOKEN=

# gunicorn のワーカー数（目安: CPU コア数 × 1〜2）
WEB_CONCURRENCY=2

# 以下は初期値。管理画面の「設定」で上書きできる
RATE_POST_PER_HOUR=5
RATE_REPORT_PER_HOUR=20
RATE_PINS_PER_MINUTE=120
DEFAULT_REPORT_THRESHOLD=3
DEFAULT_VAD_THRESHOLD=0.35
DEFAULT_MAX_DURATION_SEC=60

# 国土地理院の逆ジオコーダーを使う
GEOCODER_ENABLED=true
